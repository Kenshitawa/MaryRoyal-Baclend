DATABASE_URL="file:./dev.db"
SESSION_SECRET="replace-this-with-a-long-random-secret-at-least-32-chars"

# Production only (do not use these values locally). For Vercel + Supabase,
# DATABASE_URL should use Supavisor transaction pooling; DIRECT_URL is for migrations.
# DATABASE_URL="postgresql://..."
# DIRECT_URL="postgresql://..."
# OBJECT_STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://your-project.supabase.co"
# SUPABASE_PUBLISHABLE_KEY="public-key-used-only-by-the-RLS-verification-script"
# SUPABASE_SERVICE_ROLE_KEY="server-only-secret"
# SUPABASE_STORAGE_BUCKET="mary-royal-private"
# PRIVATE_UPLOADS_DIR="private-uploads"
# UPLOADS_DIR="private-uploads"
